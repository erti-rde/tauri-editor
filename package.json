	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@tauri-apps/plugin-store": "^2.4.4",
		"@tiptap/core": "^3.29.0",
		"@tiptap/extension-bubble-menu": "^3.29.0",
		"@tiptap/extension-highlight": "^3.29.0",
		"@tiptap/extension-image": "^3.29.0",
		"@tiptap/extension-subscript": "^3.29.0",
		"@tiptap/extension-superscript": "^3.29.0",
		"@tiptap/extension-table": "^3.29.0",
		"@tiptap/extension-text-align": "^3.29.0",
		"@tiptap/pm": "^3.29.0",
		"@tiptap/starter-kit": "^3.29.0",
		"@tiptap/suggestion": "^3.29.0",
		"citeproc": "^2.4.63",
		"dompurify": "^3.4.13",
		"pdfjs-dist": "4.9.155",
		"tippy.js": "^6.3.7",
		"tiptap-pagination-plus": "^3.1.0"
	},
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=22"
	},
	"lint-staged": {
		"*.{js,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,json,md,yaml,yml}": [
			"prettier --write"
		]
	}
}
