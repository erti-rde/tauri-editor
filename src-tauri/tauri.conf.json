{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Erti",
	"version": "0.2.5",
	"identifier": "com.erti.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Erti",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://doi.org https://api.crossref.org https://data.crosscite.org https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost",
			"assetProtocol": {
				"enable": true
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["resources/**/*"]
	}
}
