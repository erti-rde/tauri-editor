{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:webview:allow-print",
		"dialog:default",
		"fs:default",
		"fs:write-all",
		"fs:allow-resource-read-recursive",
		"fs:allow-home-read-recursive",
		"store:default",
		"opener:default"
	]
}
